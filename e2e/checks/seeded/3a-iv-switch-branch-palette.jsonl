{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"ctx_update_org","params":{"id":"e2e-fixture","gitName":"E2E Org","gitEmail":"org@e2e.invalid"}}}
{"do":{"hotkey":"cmd+shift+g"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"changes"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"terminal"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"do":{"click":"rail.terminal-2"}}
{"expect":{"pane":"terminal-2","field":"kind","equals":"terminal"}}
{"do":{"click":"rail.terminal-2"}}
{"do":{"keys":"git -C ../e2e-portal branch topic"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].exitCode","equals":"0"}}
{"do":{"click":"rail.editor-1"}}
{"dispatch":{"action":"editor_open","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-portal/index.txt"}}}
{"expect":{"tree":"contains","text":"STAGING e2e-portal: main"}}
{"do":{"hotkey":"cmd+k"}}
{"expect":{"tree":"contains","text":"RUN A COMMAND"}}
{"do":{"type":{"into":"palette.query","text":"switch branch"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"Placeholder: Branch"}}
{"do":{"type":{"into":"palette.query","text":"topic"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.topic"}}
{"expect":{"tree":"absent","text":"Placeholder: Branch"}}
{"expect":{"journal":{"contains":"\"branch\":\"topic\""}}}
{"expect":{"tree":"contains","text":"e2e-portal · topic"}}
{"expect":{"tree":"contains","text":"STAGING e2e-portal: topic"}}
{"do":{"click":"rail.terminal-2"}}
{"do":{"keys":"git -C ../e2e-portal branch --show-current"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].exitCode","equals":"0"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"topic"}}
