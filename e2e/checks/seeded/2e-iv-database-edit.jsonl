{"do":{"focus":"settings.db.name"}}

{"do":{"hotkey":"cmd+a"}}

{"do":{"keys":"ledger"}}

{"expect":{"tree":"contains","text":"EDIT ledger"}}

{"do":{"click":"settings.db.cancelEdit"}}

