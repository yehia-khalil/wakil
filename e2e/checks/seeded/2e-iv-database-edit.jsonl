{"do":{"type":{"into":"settings.db.password","text":"newsecret"}}}

{"do":{"click":"settings.db.save"}}

{"expect":{"tree":"contains","text":"Store a connection for ledger in staging? The password goes to your Keychain, not to the project file."}}

{"expect":{"tree":"absent","text":"newsecret"}}

{"do":{"click":"settings.dsn.confirm"}}

