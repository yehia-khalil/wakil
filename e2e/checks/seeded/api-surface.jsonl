{"do":{"click":"api.entry"}}
{"do":{"click":"api.entry.catalog"}}
{"expect":{"pane":"api-1","field":"entry","equals":"catalog"}}
{"expect":{"pane":"api-1","field":"credentialed","equals":"false"}}
{"do":{"click":"api.entry"}}
{"do":{"click":"api.entry.billing"}}
