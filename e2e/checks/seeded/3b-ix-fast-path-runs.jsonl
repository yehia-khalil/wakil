{"dispatch":{"action":"ctx_set_local_provider","params":{"id":"qwen","label":"Qwen 1.5B","baseURL":"{chatStub}"}}}
{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.providers"}}
{"expect":{"tree":"contains","text":"QUICK TASKS"}}
{"do":{"click":"settings.org.quickProvider"}}
{"do":{"click":"settings.org.quickProvider.qwen"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.org.quickProvider","equals":"qwen"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.org.fastPath","equals":"true"}}
{"dispatch":{"action":"api_open","params":{"entry":"catalog"}}}
{"expect":{"pane":"api-2","field":"environment","equals":"staging"}}
{"do":{"type":{"into":"window.composer","text":"go to qa"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"Ran: switch environment to qa"}}
{"expect":{"journal":{"contains":"\"via\":\"fastPath\""}}}
{"expect":{"journal":{"contains":"\"params\":{\"name\":\"qa\"}"}}}
{"expect":{"tree":"absent","text":"no agent session"}}
{"expect":{"focus":"window.composer"}}
{"dispatch":{"action":"api_open","params":{"entry":"catalog"}}}
{"expect":{"pane":"api-3","field":"environment","equals":"qa"}}
{"do":{"focus":"window.composer"}}
{"do":{"press":"Escape"}}
{"expect":{"tree":"absent","text":"Ran: switch environment to qa"}}
{"do":{"resize":{"width":1000,"height":888}}}
{"do":{"type":{"into":"window.composer","text":"go to staging"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"Ran: switch environment to staging"}}
{"expect":{"frame":"window.composer.receipt","clear":"window.composer.askAgent"}}
{"expect":{"frame":"window.composer.askAgent","inside":"window"}}
