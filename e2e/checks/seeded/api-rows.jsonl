{"dispatch":{"action":"api_open","params":{"entry":"catalog"}}}
{"do":{"type":{"into":"api.contentType","text":"application/json"}}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[0].value[0].literal","equals":"application/json"}}
{"do":{"click":"api.header.add"}}
{"do":{"type":{"into":"api.header.add.name","text":"X-Trace-Id"}}}
{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"X-Trace-Id"}}
{"do":{"type":{"into":"api.header.X-Trace-Id","text":"t-1"}}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"X-Trace-Id"}}
{"expect":{"pane":"api-1","field":"request.headers[0].value[0].literal","equals":"t-1"}}
{"expect":{"pane":"api-1","field":"request.headers[1].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[1].value[0].literal","equals":"application/json"}}
{"expect":{"pane":"api-1","field":"request.headers[2]","present":false}}
{"do":{"click":"api.header.add"}}
{"do":{"type":{"into":"api.header.add.name","text":"Authorization"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"wakil secrets set-api"}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"X-Trace-Id"}}
{"expect":{"pane":"api-1","field":"request.headers[1].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[2]","present":false}}
{"do":{"press":"Escape"}}
{"do":{"click":"api.header.add"}}
{"do":{"type":{"into":"api.header.add.name","text":"content-type"}}}
{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"X-Trace-Id"}}
{"expect":{"pane":"api-1","field":"request.headers[1].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[1].value[0].literal","equals":"application/json"}}
{"expect":{"pane":"api-1","field":"request.headers[2]","present":false}}
{"do":{"click":"api.header.X-Trace-Id.remove"}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[1]","present":false}}
{"do":{"click":"api.query.add"}}
{"do":{"type":{"into":"api.query.add.name","text":"a=b"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"a query name may not contain ="}}
{"expect":{"pane":"api-1","field":"request.query","equals":"[]"}}
{"do":{"press":"Escape"}}
{"do":{"click":"api.query.add"}}
{"do":{"type":{"into":"api.query.add.name","text":"tag"}}}
{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.query[0].name","equals":"tag"}}
{"do":{"click":"api.query.add"}}
{"do":{"type":{"into":"api.query.add.name","text":"tag"}}}
{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.query[1].name","equals":"tag"}}
{"do":{"click":"api.query[1].tag.remove"}}
{"expect":{"pane":"api-1","field":"request.query[0].name","equals":"tag"}}
{"expect":{"pane":"api-1","field":"request.query[1]","present":false}}
{"do":{"click":"api.query.tag.remove"}}
{"expect":{"pane":"api-1","field":"request.query","equals":"[]"}}
{"do":{"click":"api.header.add"}}
{"do":{"type":{"into":"api.header.add.name","text":"X-Dup"}}}
{"do":{"press":"Return"}}
{"do":{"click":"api.header.add"}}
{"do":{"type":{"into":"api.header.add.name","text":"X-Dup"}}}
{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.headers[1].name","equals":"X-Dup"}}
{"expect":{"pane":"api-1","field":"request.headers[2].name","equals":"content-type"}}
{"do":{"click":"api.header[1].X-Dup.remove"}}
{"expect":{"pane":"api-1","field":"request.headers[0].name","equals":"X-Dup"}}
{"expect":{"pane":"api-1","field":"request.headers[1].name","equals":"content-type"}}
{"expect":{"pane":"api-1","field":"request.headers[2]","present":false}}
