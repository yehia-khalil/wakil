{"dispatch":{"action":"ctx_git_token_set","params":{"id":"e2e-fixture","host":"github.com","token":"e2e-github-token"}}}
{"dispatch":{"action":"ctx_git_account_add","params":{"id":"e2e-fixture","host":"github.com","provider":"github","method":"token"}}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-1","field":"tabs[0].path","contains":"app.txt"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"files"}}
{"do":{"click":"editor.column.ticket"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"ticket"}}
{"expect":{"pane":"editor-1","field":"ticket.prs[0].openThreads","equals":"2"}}
{"expect":{"pane":"editor-1","field":"ticket.drafts[0]","present":false}}
{"dispatch":{"action":"review_reply_draft","params":{"thread":"T_1","text":"Named it in the next push"}}}
{"expect":{"pane":"editor-1","field":"ticket.drafts[0]","equals":"T_1"}}
{"dispatch":{"action":"review_reply_draft","params":{"thread":"T_2","text":"Thanks"}}}
{"expect":{"pane":"editor-1","field":"ticket.drafts[1]","equals":"T_2"}}
{"dispatch":{"action":"review_reply_draft","params":{"thread":"T_2","text":null}}}
{"expect":{"pane":"editor-1","field":"ticket.drafts[1]","present":false}}
{"dispatch":{"action":"review_reply_draft","params":{"thread":"T_1","text":""}}}
{"expect":{"pane":"editor-1","field":"ticket.drafts[0]","present":false}}
