{"dispatch":{"action":"ctx_set_project","params":{"name":"e2e-git"}}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-1","field":"tabs[0].path","contains":"/e2e-api/app.txt"}}
{"expect":{"pane":"editor-1","field":"hunks[0].kind","equals":"added"}}
{"expect":{"pane":"editor-1","field":"hunks[0].line","equals":"3"}}
{"expect":{"pane":"editor-1","field":"hunks[0].count","equals":"1"}}
{"expect":{"pane":"editor-1","field":"hunks[1]","present":false}}
{"expect":{"pane":"editor-1","field":"peek","equals":"null"}}
{"dispatch":{"action":"editor_peek_step","params":{"pane":"editor-1","delta":1},"refuses":"editor_peek_step: no peek is open; open one with editor_peek on a marked line"}}
{"dispatch":{"action":"editor_peek","params":{"pane":"editor-1","line":1},"refuses":"editor_peek: line 1 has no change mark"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-1","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":5}},"text":"LINE","expect":"line"}}}
{"expect":{"pane":"editor-1","field":"tabs[0].dirty","equals":"true"}}
{"expect":{"pane":"editor-1","field":"hunks[0].kind","equals":"changed"}}
{"expect":{"pane":"editor-1","field":"hunks[0].line","equals":"1"}}
{"expect":{"pane":"editor-1","field":"hunks[1].kind","equals":"added"}}
{"expect":{"pane":"editor-1","field":"hunks[1].line","equals":"3"}}
{"dispatch":{"action":"editor_peek","params":{"pane":"editor-1","line":3}}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"1"}}
{"expect":{"pane":"editor-1","field":"peek.count","equals":"2"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"3"}}
{"dispatch":{"action":"editor_peek_step","params":{"pane":"editor-1","delta":-1}}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"0"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"1"}}
{"dispatch":{"action":"editor_peek_step","params":{"pane":"editor-1","delta":-1}}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"0"}}
{"do":{"press":"Down"}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"1"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"3"}}
{"do":{"press":"Up"}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"0"}}
{"do":{"press":"Escape"}}
{"expect":{"pane":"editor-1","field":"peek","equals":"null"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"1"}}
{"expect":{"pane":"editor-1","field":"hunks[1].line","equals":"3"}}
{"dispatch":{"action":"editor_peek_close","params":{"pane":"editor-1"}}}
{"expect":{"pane":"editor-1","field":"peek","equals":"null"}}
{"dispatch":{"action":"editor_peek","params":{"pane":"editor-1","line":1}}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"0"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-1","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":5}},"text":"line","expect":"LINE"}}}
{"expect":{"pane":"editor-1","field":"hunks[0].kind","equals":"added"}}
{"expect":{"pane":"editor-1","field":"hunks[1]","present":false}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"0"}}
{"expect":{"pane":"editor-1","field":"peek.count","equals":"1"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"3"}}
{"do":{"hotkey":"cmd+z"}}
{"expect":{"pane":"editor-1","field":"hunks[1].kind","equals":"added"}}
{"expect":{"pane":"editor-1","field":"hunks[0].kind","equals":"changed"}}
{"expect":{"pane":"editor-1","field":"tabs[0].dirty","equals":"true"}}
{"dispatch":{"action":"editor_peek","params":{"pane":"editor-1","line":3}}}
{"expect":{"pane":"editor-1","field":"peek.index","equals":"1"}}
{"do":{"keys":"z"}}
{"expect":{"pane":"editor-1","field":"peek","equals":"null"}}
{"expect":{"pane":"editor-1","field":"hunks[1].kind","equals":"added"}}
{"dispatch":{"action":"editor_open","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api/notes"}}}
{"expect":{"pane":"editor-1","field":"hunks","equals":"null"}}
{"dispatch":{"action":"editor_peek","params":{"pane":"editor-1","line":1},"refuses":"editor_peek: the active tab has no change marks"}}
