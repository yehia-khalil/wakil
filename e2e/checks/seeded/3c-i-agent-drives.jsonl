{"dispatch":{"action":"browser_restore","params":{"pane":"browser-1"}}}
{"expect":{"pane":"browser-1","field":"tabs[0].id","equals":"t2"}}
{"expect":{"pane":"browser-1","field":"tabs[1].id","equals":"t3"}}
{"dispatch":{"action":"browser_navigate","params":{"pane":"browser-1","input":"{pageStub}/find.html"}}}
