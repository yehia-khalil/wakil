{"expect":{"pane":"browser-1","field":"canGoForward","equals":"true"}}
{"parity":{"action":"browser_forward","params":{"pane":"browser-1"},"click":"browser.forward","assert":"read_pane"}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page B"}}
{"dispatch":{"action":"browser_back","params":{"pane":"browser-1"}}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page A"}}
{"dispatch":{"action":"browser_forward","params":{"pane":"browser-1"}}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page B"}}
{"do":{"click":"browser.reload"}}
{"expect":{"journal":{"contains":"\"action\":\"browser_reload\""}}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page B"}}
{"dispatch":{"action":"browser_reload","params":{"pane":"browser-1"}}}
{"expect":{"pane":"browser-1","field":"loading","equals":"false"}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page B"}}
{"dispatch":{"action":"browser_zoom","params":{"pane":"browser-1","step":"in"}}}
