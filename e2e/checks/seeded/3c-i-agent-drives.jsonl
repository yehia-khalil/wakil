{"expect":{"pane":"browser-1","field":"zoom","equals":"1"}}
{"dispatch":{"action":"browser_new_tab","params":{"pane":"browser-1","url":"{pageStub}/a.html"}}}
{"expect":{"pane":"browser-1","field":"active","equals":"t2"}}
{"expect":{"pane":"browser-1","field":"title","equals":"Page A"}}
{"parity":{"action":"browser_select_tab","params":{"pane":"browser-1","tab":"t1"},"click":"browser.tab.t1","assert":"read_pane"}}
{"expect":{"pane":"browser-1","field":"active","equals":"t1"}}
{"dispatch":{"action":"browser_select_tab","params":{"pane":"browser-1","index":-1}}}
