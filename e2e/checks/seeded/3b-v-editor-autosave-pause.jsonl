{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.editor"}}
{"expect":{"tree":"contains","text":"AUTOSAVE"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.autosave","equals":"off"}}
{"dispatch":{"action":"editor_new_scratch","params":{}}}
{"expect":{"pane":"editor-2","field":"tabs[0].scratch","equals":"1"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"first"}}}
{"dispatch":{"action":"editor_save","params":{"pane":"editor-2","as":"{fixtureRoot}/e2e-project/autosave-off.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"/e2e-project/autosave-off.txt"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/autosave-off.txt","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":6}},"text":"edited while off"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"true"}}
{"do":{"click":"settings.editor.autosave.pause"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.autosave","equals":"pause"}}
{"dispatch":{"action":"editor_new_scratch","params":{"pane":"editor-2"}}}
{"expect":{"pane":"editor-2","field":"tabs[1].scratch","equals":"1"}}
{"expect":{"pane":"editor-2","field":"active","equals":"1"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"a scratch is never autosaved"}}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"dispatch":{"action":"editor_new_scratch","params":{"pane":"editor-2"}}}
{"expect":{"pane":"editor-2","field":"tabs[2].scratch","equals":"2"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"second"}}}
{"dispatch":{"action":"editor_save","params":{"pane":"editor-2","as":"{fixtureRoot}/e2e-project/autosave-pause.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[2].path","contains":"/e2e-project/autosave-pause.txt"}}
{"expect":{"pane":"editor-2","field":"tabs[2].dirty","equals":"false"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/autosave-pause.txt","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":7}},"text":"paused"}}}
{"expect":{"pane":"editor-2","field":"tabs[2].dirty","equals":"true"}}
{"expect":{"pane":"editor-2","field":"tabs[2].dirty","equals":"false"}}
{"expect":{"pane":"editor-2","field":"tabs[2].disk_state","equals":"inSync"}}
{"expect":{"pane":"editor-2","field":"tabs[1].scratch","equals":"1"}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"true"}}
{"dispatch":{"action":"editor_close","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/autosave-pause.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[2]","present":false}}
{"dispatch":{"action":"editor_open","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/autosave-pause.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[2].path","contains":"/e2e-project/autosave-pause.txt"}}
{"dispatch":{"action":"editor_select","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":7}}}}}
{"expect":{"pane":"editor-2","field":"selected_text","equals":"paused"}}
{"expect":{"pane":"editor-2","field":"tabs[2].dirty","equals":"false"}}
