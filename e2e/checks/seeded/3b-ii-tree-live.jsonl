{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"editor_new_scratch","params":{}}}
{"expect":{"pane":"editor-1","field":"tabs[0].scratch","equals":"1"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-1","field":"column.shown","equals":"true"}}
{"do":{"click":"editor.tree.row:e2e-api"}}
{"expect":{"tree":"contains","text":"README.md"}}
{"expect":{"tree":"absent","text":"born.txt"}}
{"dispatch":{"action":"pane_open","params":{"kind":"editor"}}}
{"expect":{"pane":"editor-2","field":"kind","equals":"editor"}}
{"dispatch":{"action":"editor_new_scratch","params":{"pane":"editor-2"}}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"born"}}}
{"dispatch":{"action":"editor_save","params":{"pane":"editor-2","as":"{fixtureRoot}/e2e-api/born.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"/e2e-api/born.txt"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"dispatch":{"action":"pane_close","params":{"id":"editor-2"}}}
{"expect":{"pane":"editor-1","field":"column.open","contains":"/e2e-api"}}
{"expect":{"tree":"contains","text":"born.txt"}}
{"expect":{"tree":"contains","text":"README.md"}}
