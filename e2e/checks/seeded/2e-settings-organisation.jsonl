{"expect":{"tree":"contains","text":"https://e2e.atlassian.net"}}
{"parity":{"action":"ctx_update_org","params":{"id":"e2e-fixture","jiraBase":"https://e2e.atlassian.net"},"click":"settings.org.jiraBase.save","assert":"tree"}}
