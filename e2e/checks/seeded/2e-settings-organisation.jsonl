{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.organisation"}}
{"expect":{"tree":"contains","text":"IDENTITY"}}
{"expect":{"tree":"contains","text":"Display name"}}
{"expect":{"tree":"contains","text":"AGENT INSTRUCTIONS"}}
{"expect":{"tree":"contains","text":"CONNECTIONS"}}
{"expect":{"tree":"contains","text":"GIT"}}
{"do":{"click":"settings.org.connections.jira"}}
{"expect":{"tree":"contains","text":"Site"}}
{"do":{"type":{"into":"settings.org.jiraBase","text":"https://e2e.atlassian.net"}}}
{"expect":{"tree":"contains","text":"https://e2e.atlassian.net"}}
{"do":{"press":"Tab"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.org.jiraBase","equals":"https://e2e.atlassian.net"}}
{"expect":{"tree":"absent","text":"Save"}}
{"do":{"type":{"into":"settings.org.displayName","text":"-left"}}}
{"do":{"press":"Tab"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.org.displayName","contains":"-left"}}
{"expect":{"tree":"contains","text":"-left"}}
