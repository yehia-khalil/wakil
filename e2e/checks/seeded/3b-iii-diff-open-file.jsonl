{"dispatch":{"action":"ctx_set_project","params":{"name":"e2e-git"}}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"editor_tree","params":{"view":"changes"}}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"changes"}}
{"dispatch":{"action":"editor_changes_select","params":{"pane":"editor-1","root":"{fixtureRoot}/e2e-api","path":"app.txt","group":"changed"}}}
{"expect":{"pane":"editor-1","field":"tabs[0].diff.loading","equals":"false"}}
{"dispatch":{"action":"editor_goto","params":{"pane":"editor-1","line":3}}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"3"}}
{"dispatch":{"action":"editor_open_file","params":{"pane":"editor-1"}}}
{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/app.txt"}}
{"expect":{"pane":"editor-1","field":"tabs[1].preview","equals":"false"}}
{"expect":{"pane":"editor-1","field":"active","equals":"1"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"3"}}
{"expect":{"pane":"editor-1","field":"tabs[0].diff.path","equals":"app.txt"}}
{"dispatch":{"action":"editor_open_file","params":{"pane":"editor-1"},"refuses":"editor_open_file: the active tab is not a Changes diff; it opens a diff's file"}}
{"dispatch":{"action":"editor_close","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-1","field":"tabs[1]","present":false}}
{"dispatch":{"action":"editor_focus_tab","params":{"pane":"editor-1","index":0}}}
{"dispatch":{"action":"editor_goto","params":{"pane":"editor-1","line":2}}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"2"}}
{"expect":{"pane":"editor-1","field":"tabs[0].diff.path","equals":"app.txt"}}
{"do":{"hotkey":"cmd+Return"}}
{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/app.txt"}}
{"expect":{"pane":"editor-1","field":"active","equals":"1"}}
{"expect":{"pane":"editor-1","field":"cursor.line","equals":"2"}}
{"expect":{"pane":"editor-1","field":"tabs[0].diff.path","equals":"app.txt"}}
{"expect":{"journal":{"contains":"\"action\":\"editor_open_file\""}}}
{"dispatch":{"action":"editor_new_scratch","params":{"pane":"editor-1"}}}
{"expect":{"pane":"editor-1","field":"tabs[2].scratch","equals":"1"}}
{"expect":{"pane":"editor-1","field":"active","equals":"2"}}
{"do":{"hotkey":"cmd+Return"}}
{"expect":{"journal":{"contains":"\"action\":\"pane_maximize\""}}}
{"expect":{"pane":"editor-1","field":"tabs[3]","present":false}}
