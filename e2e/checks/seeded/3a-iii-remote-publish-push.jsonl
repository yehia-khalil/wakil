{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"ctx_update_org","params":{"id":"e2e-fixture","gitName":"E2E Org","gitEmail":"org@e2e.invalid"}}}
{"do":{"hotkey":"cmd+shift+g"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"changes"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"terminal"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"do":{"click":"rail.terminal-2"}}
{"expect":{"pane":"terminal-2","field":"kind","equals":"terminal"}}
{"expect":{"tree":"contains","text":"e2e-portal · main"}}
{"dispatch":{"action":"editor_changes_publish","params":{"root":"{fixtureRoot}/e2e-portal"},"refuses":"this repository has no remote to publish to"}}
{"dispatch":{"action":"editor_changes_push","params":{"root":"{fixtureRoot}/e2e-portal"},"refuses":"main has no upstream — Publish it first"}}
{"dispatch":{"action":"editor_changes_pull","params":{"root":"{fixtureRoot}/e2e-portal"},"refuses":"main has no upstream — Publish it first"}}
{"do":{"click":"rail.terminal-2"}}
{"do":{"keys":"git init -q --bare -b main ../e2e-remote.git && git -C ../e2e-portal remote add origin \"$(cd .. && pwd)/e2e-remote.git\""}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].exitCode","equals":"0"}}
{"dispatch":{"action":"editor_changes_publish","params":{"root":"{fixtureRoot}/e2e-portal"}}}
{"do":{"click":"rail.terminal-2"}}
{"do":{"keys":"git -C ../e2e-portal rev-parse --abbrev-ref '@{u}'"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].exitCode","equals":"0"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"origin/main"}}
{"dispatch":{"action":"editor_changes_commit","params":{"root":"{fixtureRoot}/e2e-portal","message":"e2e to push"}}}
{"expect":{"tree":"contains","text":"e2e-portal · main ↑1 · clean"}}
{"dispatch":{"action":"editor_changes_push","params":{"root":"{fixtureRoot}/e2e-portal"}}}
{"expect":{"tree":"contains","text":"e2e-portal · main · clean"}}
{"expect":{"tree":"absent","text":"↑1"}}
{"do":{"click":"rail.terminal-2"}}
{"do":{"keys":"git -C ../e2e-remote.git --no-pager log -1 --format=%an/%s main"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].exitCode","equals":"0"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"E2E Org/e2e to push"}}
