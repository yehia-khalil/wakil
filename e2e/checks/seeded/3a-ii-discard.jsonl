{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"do":{"hotkey":"cmd+shift+g"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"changes"}}
{"expect":{"tree":"contains","text":"?, notes"}}
{"do":{"click":"editor.changes.row:e2e-api/notes:untracked"}}
{"expect":{"pane":"editor-1","field":"column.changes_highlight.path","equals":"notes"}}
{"do":{"click":"editor.changes.row:e2e-api/notes:untracked.discard"}}
{"expect":{"journal":{"contains":"\"action\":\"editor_changes_discard\""}}}
{"expect":{"tree":"absent","text":"?, notes"}}
{"expect":{"tree":"contains","text":"?, BookingController.php"}}
{"expect":{"tree":"contains","text":"M, app.txt"}}
{"do":{"click":"editor.changes.row:e2e-api/BookingController.php:untracked"}}
{"expect":{"pane":"editor-1","field":"column.changes_highlight.path","equals":"BookingController.php"}}
{"do":{"click":"editor.changes.e2e-api.untracked.discardAll"}}
{"expect":{"journal":{"contains":"\"group\":\"untracked\""}}}
{"expect":{"tree":"absent","text":"?, BookingController.php"}}
{"expect":{"tree":"absent","text":"Untracked, "}}
{"expect":{"tree":"contains","text":"M, app.txt"}}
{"do":{"click":"editor.changes.row:e2e-portal/index.txt:changed"}}
{"dispatch":{"action":"editor_close","params":{"pane":"editor-1"}}}
{"expect":{"pane":"editor-1","field":"tabs[0]","present":false}}
{"expect":{"pane":"editor-1","field":"column.changes_highlight.path","equals":"index.txt"}}
{"parity":{"action":"editor_changes_discard","params":{"root":"{fixtureRoot}/e2e-portal","paths":["index.txt"]},"click":"editor.changes.e2e-portal.changed.discardAll","assert":"tree"}}
{"expect":{"tree":"contains","text":"e2e-portal · main · clean"}}
{"expect":{"tree":"absent","text":"M, index.txt"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"terminal"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"do":{"click":"rail.terminal-2"}}
{"expect":{"pane":"terminal-2","field":"kind","equals":"terminal"}}
{"do":{"keys":"test ! -e ../e2e-api/notes && test ! -e ../e2e-api/BookingController.php && echo untracked-gone"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"untracked-gone"}}
{"do":{"keys":"cat ../e2e-portal/index.txt"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"portal"}}
{"do":{"keys":"git -C ../e2e-portal status --porcelain | wc -l | tr -d ' '"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"0"}}
{"do":{"keys":"git -C ../e2e-api --no-pager diff --numstat -- app.txt"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"1\t0\tapp.txt"}}
