{"dispatch":{"action":"ctx_git_token_set","params":{"id":"e2e-fixture","host":"github.com","token":"e2e-github-token"}}}
{"dispatch":{"action":"ctx_git_account_add","params":{"id":"e2e-fixture","host":"github.com","provider":"github","method":"token"}}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"hotkey":"cmd+p"}}
{"do":{"keys":"terminal"}}
{"expect":{"frame":"palette.row.newpane:terminal","minWidth":10}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"expect":{"pane":"terminal-1","field":"kind","equals":"terminal"}}
{"do":{"keys":"echo ready"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].output[0]","equals":"ready"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"app.txt"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-2","field":"column.view","equals":"files"}}
{"do":{"click":"editor.column.ticket"}}
{"expect":{"pane":"editor-2","field":"column.view","equals":"ticket"}}
{"expect":{"tree":"contains","text":"Log in with a token"}}
{"dispatch":{"action":"ticket_record_update","params":{"key":"INI-142","section":"verified","op":"add","text":"Login works against the stub","how":"ran it"}}}
{"dispatch":{"action":"ticket_record_update","params":{"key":"INI-142","section":"decisions","op":"edit","id":"d1","text":"Tokens live in the Keychain only"}}}
{"dispatch":{"action":"ticket_record_update","params":{"key":"INI-142","section":"nowhere","op":"add","text":"x"},"refuses":"unknown ticket section \"nowhere\""}}
{"dispatch":{"action":"ticket_record_update","params":{"key":"INI-142","section":"next","op":"add","text":"x"},"refuses":"the next line is set, not \"add\""}}
{"do":{"click":"editor.ticket.refresh"}}
{"expect":{"pane":"editor-2","field":"ticket.reading","equals":"false"}}
{"expect":{"tree":"contains","text":"Login works against the stub"}}
{"expect":{"tree":"contains","text":"ran it"}}
{"expect":{"tree":"contains","text":"Verified 1"}}
{"expect":{"tree":"contains","text":"Tokens live in the Keychain only"}}
{"do":{"click":"rail.terminal-1"}}
{"do":{"keys":"plutil -extract verified.0.by raw -o - ~/.wakil/orgs/e2e-fixture/tickets/INI-142.json"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].output[0]","equals":"agent"}}
{"do":{"keys":"plutil -extract decisions.0.edited raw -o - ~/.wakil/orgs/e2e-fixture/tickets/INI-142.json"}}
