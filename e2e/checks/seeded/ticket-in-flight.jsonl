{"expect":{"tree":"contains","text":"Reading ini-160-stall…"}}
{"do":{"click":"editor.ticket.back"}}
{"expect":{"pane":"editor-2","field":"column.ticket_shown","equals":"null"}}
{"do":{"click":"editor.ticket.waiting:INI-142"}}
{"expect":{"pane":"editor-2","field":"column.ticket_shown","equals":"INI-142"}}
