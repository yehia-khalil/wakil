{"dispatch":{"action":"ctx_git_token_set","params":{"id":"e2e-fixture","host":"github.com","token":"e2e-github-token"}}}
{"dispatch":{"action":"ctx_git_account_add","params":{"id":"e2e-fixture","host":"github.com","provider":"github","method":"token"}}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"hotkey":"cmd+p"}}
{"do":{"keys":"terminal"}}
{"expect":{"frame":"palette.row.newpane:terminal","minWidth":10}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"expect":{"pane":"terminal-1","field":"kind","equals":"terminal"}}
{"do":{"keys":"git -C ../e2e-api checkout -q main && git -C ../e2e-api branch --show-current"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].output[0]","equals":"main"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"app.txt"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-2","field":"column.view","equals":"files"}}
{"do":{"click":"editor.column.ticket"}}
{"expect":{"pane":"editor-2","field":"column.view","equals":"ticket"}}
{"expect":{"pane":"editor-2","field":"ticket.branch","equals":"main"}}
{"expect":{"tree":"contains","text":"WAITING ON YOU"}}
{"expect":{"tree":"contains","text":"IN FLIGHT"}}
{"expect":{"frame":"editor.ticket.waiting:INI-142","inside":"editor.ticket"}}
{"expect":{"frame":"editor.ticket.inflight:INI-170","inside":"editor.ticket"}}
{"expect":{"frame":"editor.ticket.inflight:INI-150","inside":"editor.ticket"}}
{"dispatch":{"action":"ticket_in_flight","params":{}}}
{"parity":{"action":"ticket_show","params":{"pane":"editor-2","key":"INI-142"},"click":"editor.ticket.waiting:INI-142","assert":"read_pane"}}
{"expect":{"pane":"editor-2","field":"column.ticket_shown","equals":"INI-142"}}
{"expect":{"pane":"editor-2","field":"ticket.branch","equals":"main"}}
{"expect":{"tree":"contains","text":"#212  ini-142-login → main      open · checks 1/2 · 1 failing"}}
{"expect":{"tree":"contains","text":"Log in with a token"}}
