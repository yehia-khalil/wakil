{"parity":{"action":"db_set_dsn","params":{"projectPath":"{fixtureRoot}/e2e-project/.wakil/project.json","environment":"staging","name":"ledger","driver":"mysql","dsn":"e2e:secret@tcp(localhost:3306)/ledger"},"click":"settings.dsn.confirm","assert":"tree"}}
{"expect":{"tree":"contains","text":"read db:e2e-project:staging:ledger"}}
