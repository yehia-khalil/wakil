{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"dispatch":{"action":"editor_new_scratch","params":{}}}
{"expect":{"pane":"editor-1","field":"tabs[0].scratch","equals":"1"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-1","field":"column.shown","equals":"true"}}
{"expect":{"tree":"absent","text":"README.md"}}
{"parity":{"action":"editor_tree_expand","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api"},"click":"editor.tree.row:e2e-api","assert":"read_pane"}}
{"expect":{"pane":"editor-1","field":"column.open","contains":"/e2e-api"}}
{"expect":{"tree":"contains","text":"README.md"}}
{"do":{"click":"editor.tree.row:e2e-api/README.md"}}
{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/README.md"}}
{"expect":{"pane":"editor-1","field":"tabs[1].preview","equals":"true"}}
{"do":{"click":"editor.tree.row:e2e-api/app.txt"}}
{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/app.txt"}}
{"expect":{"pane":"editor-1","field":"tabs[1].preview","equals":"true"}}
{"expect":{"pane":"editor-1","field":"tabs[2]","present":false}}
{"dispatch":{"action":"editor_open","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api/app.txt","preview":false}}}
{"expect":{"pane":"editor-1","field":"tabs[1].preview","equals":"false"}}
{"do":{"click":"editor.tree.row:e2e-api/README.md"}}
{"expect":{"pane":"editor-1","field":"tabs[2].path","contains":"/e2e-api/README.md"}}
{"expect":{"pane":"editor-1","field":"tabs[2].preview","equals":"true"}}
{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/app.txt"}}
{"parity":{"action":"editor_tree_collapse","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api"},"click":"editor.tree.row:e2e-api","assert":"read_pane"}}
{"expect":{"pane":"editor-1","field":"column.open","equals":"[]"}}
{"expect":{"journal":{"contains":"\"action\":\"editor_tree_collapse\""}}}
