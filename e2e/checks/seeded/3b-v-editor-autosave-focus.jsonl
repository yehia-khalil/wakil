{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.editor"}}
{"expect":{"tree":"contains","text":"AUTOSAVE"}}
{"do":{"click":"settings.editor.autosave.focus"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.autosave","equals":"focus"}}
{"dispatch":{"action":"editor_new_scratch","params":{}}}
{"expect":{"pane":"editor-2","field":"tabs[0].scratch","equals":"1"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"f1"}}}
{"dispatch":{"action":"editor_save","params":{"pane":"editor-2","as":"{fixtureRoot}/e2e-project/focus-a.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"/e2e-project/focus-a.txt"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"dispatch":{"action":"editor_new_scratch","params":{"pane":"editor-2"}}}
{"expect":{"pane":"editor-2","field":"tabs[1].scratch","equals":"1"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"scratch stays unsaved"}}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"dispatch":{"action":"pane_focus","params":{"id":"editor-2"}}}
{"dispatch":{"action":"editor_focus_tab","params":{"pane":"editor-2","index":0}}}
{"expect":{"pane":"editor-2","field":"active","equals":"0"}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":3}},"text":"f2"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"true"}}
{"dispatch":{"action":"editor_focus_tab","params":{"pane":"editor-2","index":1}}}
{"expect":{"pane":"editor-2","field":"active","equals":"1"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/focus-a.txt","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":3}},"text":"f3"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"true"}}
{"dispatch":{"action":"pane_focus","params":{"id":"settings-1"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"expect":{"pane":"editor-2","field":"tabs[0].disk_state","equals":"inSync"}}
{"expect":{"pane":"editor-2","field":"tabs[1].scratch","equals":"1"}}
{"expect":{"pane":"editor-2","field":"tabs[1].dirty","equals":"true"}}
{"dispatch":{"action":"editor_close","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/focus-a.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].scratch","equals":"1"}}
{"dispatch":{"action":"editor_open","params":{"pane":"editor-2","path":"{fixtureRoot}/e2e-project/focus-a.txt"}}}
{"expect":{"pane":"editor-2","field":"tabs[1].path","contains":"/e2e-project/focus-a.txt"}}
{"expect":{"pane":"editor-2","field":"active","equals":"1"}}
{"dispatch":{"action":"editor_select","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":3}}}}}
{"expect":{"pane":"editor-2","field":"selected_text","equals":"f3"}}
