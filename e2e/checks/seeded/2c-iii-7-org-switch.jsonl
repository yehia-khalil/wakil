{"expect":{"tree":"contains","text":"e2e-fixture"}}
{"do":{"click":"landing.row.open:terminal"}}
{"expect":{"pane":"terminal-1","field":"kind","equals":"terminal"}}
{"do":{"keys":"touch wakil-e2e-switch-marker && tail -f wakil-e2e-switch-marker"}}
{"do":{"press":"Return"}}
{"expect":{"process":{"any-matching":"tail -f wakil-e2e-switch-marker"}}}
{"do":{"hotkey":"cmd+shift+o"}}
{"expect":{"tree":"contains","text":"ORGANISATION"}}
{"do":{"click":"org.row.e2e-fixture-two.switch"}}
{"expect":{"tree":"contains","text":"e2e-project-two"}}
{"expect":{"process":{"none-matching":"tail -f wakil-e2e-switch-marker"}}}
{"do":{"click":"landing.row.open:terminal"}}
{"do":{"keys":"echo after-the-switch"}}
{"do":{"press":"Return"}}
{"expect":{"journal":{"contains":"echo after-the-switch"}}}
{"expect":{"journal":{"contains":"e2e-fixture-two"}}}
