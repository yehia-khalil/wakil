{"do":{"click":"landing.row.open:terminal"}}
{"expect":{"pane":"terminal-1","field":"kind","equals":"terminal"}}
{"do":{"keys":"printf 'a\\000b' > ~/../e2e-project/ro.bin && echo ro-written"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].output","contains":"ro-written"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].exitCode","equals":"0"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-project/ro.bin"}}}
{"expect":{"pane":"editor-2","field":"tabs[0].path","contains":"/e2e-project/ro.bin"}}
{"expect":{"pane":"editor-2","field":"tabs[0].notice","equals":"ro.bin is a binary file"}}
{"expect":{"tree":"contains","text":"ro.bin is a binary file"}}
{"dispatch":{"action":"editor_save","params":{"pane":"editor-2"},"refuses":"editor_save: ro.bin is open read-only (ro.bin is a binary file); it cannot be saved from the editor"}}
{"dispatch":{"action":"editor_replace_range","params":{"pane":"editor-2","range":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"text":"x"},"refuses":"editor_replace_range: ro.bin is open read-only (ro.bin is a binary file); it cannot be changed from the editor"}}
{"expect":{"pane":"editor-2","field":"tabs[0].dirty","equals":"false"}}
{"expect":{"pane":"editor-2","field":"tabs[0].notice","equals":"ro.bin is a binary file"}}
