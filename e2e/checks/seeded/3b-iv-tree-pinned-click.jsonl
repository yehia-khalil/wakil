{"expect":{"pane":"editor-1","field":"tabs[1].path","contains":"/e2e-api/README.md"}}
{"expect":{"pane":"editor-1","field":"tabs[1].dirty","equals":"false"}}
{"dispatch":{"action":"editor_trash","params":{"pane":"editor-1","path":"{fixtureRoot}/e2e-api/app.txt"},"refuses":"/e2e-api/app.txt does not exist"}}
