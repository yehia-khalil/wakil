{"do":{"hotkey":"cmd+,"}}
{"expect":{"tree":"contains","text":"SETTINGS"}}
{"do":{"click":"settings.tree.browser"}}
{"expect":{"tree":"contains","text":"Search engine"}}
{"expect":{"tree":"contains","text":"Start page"}}
{"expect":{"frame":"settings.browser.clear","inside":"window"}}
{"expect":{"tree":"contains","text":"Browsing data is this organisation's."}}
{"dispatch":{"action":"ctx_browser_settings","params":{}}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.browser.searchEngine","equals":"google"}}
{"do":{"click":"settings.browser.searchEngine.duckduckgo"}}
{"dispatch":{"action":"ctx_browser_settings","params":{}}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.browser.searchEngine","equals":"duckduckgo"}}
{"do":{"focus":"settings.browser.startPage"}}
{"do":{"keys":"not a url"}}
{"do":{"press":"Tab"}}
{"expect":{"tree":"contains","text":"start page \"not a url\" is not an http or https URL — leave it empty for a blank page"}}
{"dispatch":{"action":"ctx_browser_settings","params":{}}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.browser.startPage","equals":""}}
{"do":{"click":"settings.browser.clear"}}
{"expect":{"tree":"contains","text":"Every site signs you out, in every project."}}
{"do":{"click":"settings.browser.clear.keep"}}
{"expect":{"tree":"absent","text":"Every site signs you out, in every project."}}
{"expect":{"tree":"contains","text":"Search engine"}}
{"dispatch":{"action":"ctx_set_browser_settings","params":{"searchEngine":"google"}}}
