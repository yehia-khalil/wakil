{"do":{"press":"Return"}}
{"expect":{"pane":"api-1","field":"request.path[1].slot","equals":"id"}}
{"do":{"focus":"api.path"}}
{"do":{"hotkey":"cmd+Down"}}
{"do":{"press":"/"}}
{"do":{"press":"c"}}
{"do":{"press":"o"}}
{"do":{"press":"n"}}
{"do":{"press":"f"}}
{"do":{"press":"i"}}
{"do":{"press":"r"}}
{"do":{"press":"m"}}
{"expect":{"pane":"api-1","field":"request.path[0].literal","equals":"/v1/bookings/"}}
{"expect":{"pane":"api-1","field":"request.path[1].slot","equals":"id"}}
{"expect":{"pane":"api-1","field":"request.path[2].literal","equals":"/confirm"}}
{"do":{"focus":"api.path"}}
{"do":{"hotkey":"cmd+Up"}}
{"do":{"press":"Right"}}
{"do":{"press":"Right"}}
{"do":{"press":"Right"}}
{"do":{"press":"Backspace"}}
{"do":{"press":"2"}}
{"expect":{"pane":"api-1","field":"request.path[0].literal","equals":"/v2/bookings/"}}
{"expect":{"pane":"api-1","field":"request.path[1].slot","equals":"id"}}
{"expect":{"pane":"api-1","field":"request.path[2].literal","equals":"/confirm"}}
{"do":{"click":"api.path.part.1.remove"}}
{"expect":{"pane":"api-1","field":"request.path[0].literal","equals":"/v2/bookings//confirm"}}
{"expect":{"pane":"api-1","field":"request.path[1]","present":false}}
{"expect":{"pane":"api-1","field":"request.path[2]","present":false}}
{"do":{"click":"api.path.hole"}}
