{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"e2e-git"}}
{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.editor"}}
{"expect":{"tree":"contains","text":"Show ignored files"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.showIgnored","equals":"true"}}
{"dispatch":{"action":"editor_new_scratch","params":{}}}
{"expect":{"pane":"editor-2","field":"tabs[0].scratch","equals":"1"}}
{"dispatch":{"action":"editor_tree","params":{"pane":"editor-2","shown":true,"view":"files"}}}
{"expect":{"pane":"editor-2","field":"column.shown","equals":"true"}}
{"do":{"click":"editor.tree.row:e2e-api"}}
{"expect":{"tree":"contains","text":"text .gitignore"}}
{"expect":{"tree":"contains","text":"text .env"}}
{"parity":{"action":"ctx_set_editor_settings","params":{"showIgnored":false},"click":"settings.editor.showIgnored.off","assert":"tree"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.showIgnored","equals":"false"}}
{"dispatch":{"action":"ctx_editor_settings","params":{}}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.showIgnored","equals":"false"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"keys":"README.md"}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"hotkey":"cmd+a"}}
{"do":{"keys":".env"}}
{"expect":{"tree":"contains","text":"Value: .env"}}
{"expect":{"tree":"contains","text":"text 0 of "}}
{"do":{"press":"Escape"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"tree":"contains","text":"text .gitignore"}}
{"expect":{"tree":"contains","text":"text vendor"}}
{"expect":{"tree":"absent","text":"text .env"}}
{"do":{"click":"settings.editor.showIgnored.on"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.editor.showIgnored","equals":"true"}}
{"expect":{"tree":"contains","text":"text .env"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"keys":".env"}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"press":"Return"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"pane":"editor-2","field":"tabs[1].path","contains":"/e2e-api/.env"}}
