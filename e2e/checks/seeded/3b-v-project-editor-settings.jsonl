{"do":{"hotkey":"cmd+,"}}
{"expect":{"tree":"contains","text":"SETTINGS"}}
{"do":{"click":"settings.tree.projectEditor.e2e-project"}}
{"expect":{"tree":"contains","text":"INDENTATION"}}
{"expect":{"tree":"contains","text":"Tab size"}}
{"expect":{"tree":"contains","text":"Indent with"}}
{"expect":{"tree":"contains","text":"so they travel with the code"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].name","equals":"e2e-project"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.tabSize","equals":"4"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.insertSpaces","equals":"true"}}
{"do":{"focus":"settings.projectEditor.tabSize"}}
{"do":{"hotkey":"cmd+a"}}
{"do":{"keys":"2"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.tabSize","equals":"2"}}
{"do":{"focus":"settings.projectEditor.tabSize"}}
{"do":{"hotkey":"cmd+a"}}
{"do":{"keys":"17"}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"tab size 17 is out of range: 1 to 16"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.tabSize","equals":"2"}}
{"dispatch":{"action":"ctx_set_project_editor_settings","params":{"projectPath":"{fixtureRoot}/e2e-project/.wakil/project.json","tabSize":0},"refuses":"tab size 0 is out of range: 1 to 16"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.tabSize","equals":"2"}}
{"parity":{"action":"ctx_set_project_editor_settings","params":{"projectPath":"{fixtureRoot}/e2e-project/.wakil/project.json","insertSpaces":false},"click":"settings.projectEditor.indent.tabs","assert":"tree"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.insertSpaces","equals":"false"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[1].editor.tabSize","equals":"2"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[0].name","equals":"e2e-git"}}
{"expect":{"pane":"settings-1","field":"configuration.structuredContent.projects[0].editor.tabSize","equals":"4"}}
