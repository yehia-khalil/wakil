{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"window.composer","text":"propose a portal teammate"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"‘propose a portal teammate’ suggests a teammate for e2e-portal:"}}
{"do":{"type":{"into":"window.teammates.brief.e2e-portal","text":" Keep it small."}}}
{"do":{"click":"window.composer"}}
{"expect":{"tree":"contains","text":"Keep it small."}}
{"dispatch":{"action":"conversation_propose_teammate","params":{"repo":"e2e-portal","brief":"Only the form, please."}}}
{"expect":{"tree":"contains","text":"(replacing the last suggestion)"}}
{"do":{"click":"window.teammates.dismiss.e2e-portal"}}
{"expect":{"tree":"absent","text":"suggests a teammate for e2e-portal:"}}
{"expect":{"tree":"contains","text":"The operator dismissed the teammate for e2e-portal; it is not proposed again here."}}
{"dispatch":{"action":"conversation_propose_teammate","params":{"repo":"e2e-portal","brief":"Please?"},"refuses":"decision 17"}}
{"dispatch":{"action":"conversation_teammate_dismiss","params":{"proposal":"teammate-1"},"refuses":"only the operator starts, dismisses or edits a proposed teammate"}}
{"do":{"type":{"into":"window.composer","text":"nothing for this crew member"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"said there is nothing to do"}}
{"expect":{"tree":"contains","text":"done · nothing to do: the portal needs nothing. Close it when you have read this."}}
