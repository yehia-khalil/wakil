{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"new terminal"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"expect":{"pane":"terminal-1","field":"kind","equals":"terminal"}}
{"do":{"type":{"into":"window.composer","text":"write the workspace note"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"wrote the workspace note"}}
{"expect":{"tree":"contains","text":"Started workspace ‘write the workspace note’"}}
{"do":{"type":{"into":"window.composer","text":"hold a turn open here"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"hold a turn open here"}}
{"dispatch":{"action":"workspace_new_conversation","params":{"workspace":"write-the-workspace-note"}}}
{"expect":{"focus":"window.composer"}}
{"expect":{"tree":"absent","text":"wrote the workspace note"}}
{"do":{"type":{"into":"window.composer","text":"write the second note"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"wrote the second note"}}
{"expect":{"tree":"contains","text":"‘write the workspace note’ is working in e2e-api, so this conversation branched off into workspace"}}
{"expect":{"tree":"contains","text":"write-the-workspace-note--"}}
{"do":{"hotkey":"cmd+shift+h"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"tree":"contains","text":"branched off"}}
{"do":{"click":"landing.project.e2e-git"}}
{"expect":{"tree":"contains","text":"STAGING"}}
{"do":{"click":"rail.terminal-1"}}
{"do":{"keys":"touch ~/wakil-e2e-release-held; git -C ../e2e-api worktree list --porcelain | grep -c '^worktree '"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-1","field":"blocks[-1].output[0]","equals":"3"}}
{"do":{"hotkey":"cmd+shift+h"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"tree":"absent","text":"Value: working"}}
{"dispatch":{"action":"workspace_archive","params":{"workspace":"write-the-workspace-note","confirm":true}}}
{"expect":{"journal":{"contains":"\"action\":\"workspace_archive\""}}}
{"do":{"click":"landing.project.e2e-git"}}
{"expect":{"tree":"contains","text":"STAGING"}}
{"do":{"hotkey":"cmd+shift+h"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"tree":"contains","text":"1 archived workspace"}}
{"expect":{"tree":"contains","text":"write the second note"}}
{"expect":{"tree":"absent","text":"· branched off"}}
