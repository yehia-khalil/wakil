{"dispatch":{"action":"ctx_git_token_set","params":{"id":"e2e-fixture","host":"github.com","token":"e2e-github-token"}}}
{"dispatch":{"action":"ctx_git_account_add","params":{"id":"e2e-fixture","host":"github.com","provider":"github","method":"token"}}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"dispatch":{"action":"editor_open","params":{"path":"{fixtureRoot}/e2e-api/app.txt"}}}
{"expect":{"pane":"editor-1","field":"tabs[0].path","contains":"app.txt"}}
{"do":{"hotkey":"cmd+b"}}
{"expect":{"pane":"editor-1","field":"column.view","equals":"files"}}
{"do":{"click":"editor.column.ticket"}}
{"expect":{"pane":"editor-1","field":"ticket.branch","equals":"ini-142-login"}}
{"do":{"click":"editor.ticket.handOff"}}
{"expect":{"pane":"editor-1","field":"ticket.handoff.open","equals":"true"}}
{"do":{"type":{"into":"ticket.handoff.brief","text":" Needs check: hand off."}}}
{"do":{"click":"ticket.handoff.start"}}
{"expect":{"pane":"editor-1","field":"ticket.handoff.open","equals":"false"}}
{"expect":{"journal":{"contains":"\"action\":\"ticket_hand_off\""}}}
{"do":{"hotkey":"cmd+shift+h"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"frame":"landing.needs","inside":"window"}}
{"expect":{"tree":"contains","text":"checks failing 1"}}
{"do":{"resize":{"width":1000,"height":888}}}
{"expect":{"frame":"landing.needs:0","inside":"window"}}
{"expect":{"frame":"landing.needs:0.act","clear":"landing.needs:0"}}
