{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"window.composer","text":"write the workspace note"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"wrote the workspace note"}}
{"expect":{"tree":"contains","text":"Started workspace ‘write the workspace note’"}}
{"expect":{"tree":"contains","text":"— a copy of e2e-api on"}}
{"expect":{"tree":"contains","text":"› write the workspace note"}}
{"expect":{"tree":"contains","text":"workspace copy"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"terminal"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.newpane:terminal"}}
{"expect":{"tree":"contains","text":"workspace copy"}}
{"do":{"keys":"git worktree list --porcelain | grep -c '^worktree '"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"2"}}
{"do":{"keys":"test -e ws-note.txt && echo IN-THE-COPY"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"IN-THE-COPY"}}
{"do":{"keys":"grep -c unstaged app.txt; grep -c unstaged \"$(git worktree list --porcelain | head -1 | cut -c10-)/app.txt\""}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"0"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[1]","equals":"1"}}
{"do":{"keys":"test -e \"$(git worktree list --porcelain | head -1 | cut -c10-)/ws-note.txt\" || echo MAIN-UNTOUCHED"}}
{"do":{"press":"Return"}}
{"expect":{"pane":"terminal-2","field":"blocks[-1].output[0]","equals":"MAIN-UNTOUCHED"}}
