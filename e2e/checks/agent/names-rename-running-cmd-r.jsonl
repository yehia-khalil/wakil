{"expect":{"tree":"contains","text":"e2e-fixture"}}
{"do":{"type":{"into":"window.composer","text":"hold a turn open here"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"hold a turn open here"}}
{"do":{"hotkey":"cmd+n"}}
{"expect":{"frame":"landing.row.running:0","inside":"window"}}
{"expect":{"tree":"contains","text":"Value: working"}}
{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"hold a turn"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"hotkey":"cmd+r"}}
{"expect":{"tree":"contains","text":"Placeholder: Conversation name"}}
{"expect":{"focus":"palette.query"}}
{"do":{"keys":"Dropped Name"}}
{"expect":{"label":"palette.row.name","contains":"Rename to “Dropped Name”"}}
{"do":{"press":"Escape"}}
{"expect":{"tree":"absent","text":"Placeholder: Conversation name"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"hotkey":"cmd+r"}}
{"expect":{"tree":"contains","text":"Placeholder: Conversation name"}}
{"expect":{"focus":"palette.query"}}
{"do":{"keys":"Held Billing"}}
{"expect":{"label":"palette.row.name","contains":"Rename to “Held Billing”"}}
{"do":{"press":"Return"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"expect":{"label":"landing.row.running:0","contains":"Held Billing"}}
{"expect":{"tree":"absent","text":"Dropped Name"}}
{"expect":{"frame":"landing.row.running:0","inside":"window"}}
{"do":{"hotkey":"cmd+p"}}
{"do":{"keys":"terminal"}}
