{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"dispatch":{"action":"running_save","params":{"recipes":{"e2e-static":{"processes":[{"name":"web","command":"python3 -m http.server $WAKIL_PORT"}],"ready":{"output":"Serving HTTP"}}},"repos":{"e2e-api":{"recipe":"e2e-static"}}}}}
{"do":{"type":{"into":"window.composer","text":"write the workspace note"}}}
{"do":{"press":"Return"}}
{"expect":{"tree":"contains","text":"Started workspace ‘write the workspace note’"}}
{"dispatch":{"action":"workspace_run","params":{"repo":"e2e-api"}}}
{"expect":{"journal":{"contains":"\"action\":\"workspace_run\""}}}
{"do":{"hotkey":"cmd+n"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"tree":"contains","text":"e2e-api web running on :"}}
{"expect":{"frame":"landing.card:0.stop","inside":"window"}}
{"do":{"click":"landing.card:0.stop"}}
{"expect":{"tree":"absent","text":"e2e-api web running on :"}}
{"do":{"click":"landing.card:0.run"}}
{"expect":{"tree":"contains","text":"e2e-api web running on :"}}
{"do":{"click":"landing.card:0.expand"}}
{"expect":{"tree":"contains","text":"write-the-workspace-note"}}
{"do":{"click":"landing.row.running:0"}}
{"expect":{"tree":"contains","text":"STAGING"}}
{"dispatch":{"action":"workspace_stop","params":{}}}
{"do":{"hotkey":"cmd+n"}}
{"expect":{"frame":"landing","minWidth":40}}
{"expect":{"tree":"contains","text":"quiet projects —"}}
{"expect":{"tree":"absent","text":"e2e-api web running on :"}}
