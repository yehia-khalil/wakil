{"do":{"hotkey":"cmd+p"}}
{"expect":{"tree":"contains","text":"OPEN OR SWITCH TO"}}
{"do":{"type":{"into":"palette.query","text":"e2e-git"}}}
{"expect":{"tree":"contains","text":"text 1 of "}}
{"do":{"click":"palette.row.project:e2e-git"}}
{"expect":{"tree":"absent","text":"OPEN OR SWITCH TO"}}
{"do":{"hotkey":"cmd+,"}}
{"do":{"click":"settings.tree.projectRunning.e2e-git"}}
{"do":{"click":"settings.running.repo.e2e-api"}}
{"expect":{"tree":"contains","text":"e2e-api has no recipe yet"}}
{"do":{"click":"settings.running.detect"}}
{"expect":{"tree":"contains","text":"Detect — e2e-api"}}
{"expect":{"tree":"contains","text":"Drafted in ‘Draft how e2e-api runs’ — e2e-api"}}
{"expect":{"frame":"settings.running.draft.title","inside":"settings.pane"}}
{"expect":{"journal":{"contains":"\"action\":\"running_draft_propose\""}}}
{"expect":{"tree":"contains","text":"Processes: web: python3 -m http.server $WAKIL_PORT"}}
{"do":{"click":"settings.running.proposal.discard"}}
{"expect":{"tree":"absent","text":"Detect — e2e-api"}}
{"expect":{"frame":"settings.running.draft.save","inside":"settings.pane"}}
{"do":{"click":"settings.running.draft.save"}}
{"expect":{"tree":"absent","text":"Drafted in ‘Draft how e2e-api runs’"}}
{"expect":{"tree":"contains","text":"Recipe e2e-drafted"}}
{"do":{"click":"settings.running.try"}}
{"expect":{"tree":"contains","text":"Last Try failed"}}
{"expect":{"tree":"contains","text":"Fix proposed by ‘Draft how e2e-api runs’ — e2e-api"}}
{"do":{"click":"settings.running.draft.discard"}}
{"expect":{"tree":"absent","text":"Fix proposed by ‘Draft how e2e-api runs’"}}
{"expect":{"tree":"contains","text":"Recipe e2e-drafted"}}
{"expect":{"frame":"settings.running.tryFix","inside":"settings.running.stop.prepare"}}
{"do":{"click":"settings.running.tryFix"}}
{"expect":{"tree":"contains","text":"Fix proposed by ‘Draft how e2e-api runs’ — e2e-api"}}
{"expect":{"frame":"settings.running.draft","inside":"settings.running.stop.prepare"}}
