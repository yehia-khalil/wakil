{
  "rules": [
    {
      "match": "message from another conversation (‘send word to the first conversation’",
      "reply": "read the word from the other conversation"
    },
    {
      "match": "message from another conversation (‘thread turn one’",
      "reply": "read the thanks from the first conversation"
    },
    {
      "match": "send word to the first conversation",
      "call": { "action": "conversation_message", "echo": true, "params": { "to": "thread turn one", "text": "the login endpoint answers 201 now" } },
      "reply": "sent word to the first conversation"
    },
    {
      "match": "Draft how e2e-api runs",
      "call": { "action": "running_draft_propose", "echo": true, "params": { "repo": "e2e-api", "recipeName": "e2e-drafted", "recipe": { "setup": ["false"], "processes": [{ "name": "web", "command": "python3 -m http.server $WAKIL_PORT" }], "ready": { "output": "Serving HTTP" }, "notes": { "setup": "README" } } } },
      "reply": "drafted how e2e-api runs"
    },
    {
      "match": "Try of e2e-api's recipe failed",
      "call": { "action": "running_draft_propose", "echo": true, "params": { "repo": "e2e-api", "recipeName": "e2e-drafted", "recipe": { "setup": [], "processes": [{ "name": "web", "command": "python3 -m http.server $WAKIL_PORT" }], "ready": { "output": "Serving HTTP" } } } },
      "reply": "proposed a fix for e2e-api"
    },
    {
      "match": "read this page",
      "call": { "action": "browser_read_page", "echo": true, "params": { "pane": "browser-1" } },
      "reply": "read the release notes"
    },
    {
      "match": "press return in the guest name",
      "call": { "action": "browser_press", "echo": true, "params": { "pane": "browser-1", "ref": "e1", "key": "Return" } },
      "reply": "pressed return in the guest name"
    },
    {
      "match": "scroll to the back link",
      "call": { "action": "browser_scroll", "echo": true, "params": { "pane": "browser-1", "ref": "e6" } },
      "reply": "scrolled to the back link"
    },
    {
      "match": "fill the guest name",
      "call": { "action": "browser_type", "echo": true, "params": { "pane": "browser-1", "ref": "e1", "text": "Ada Lovelace" } },
      "reply": "typed the guest name"
    },
    {
      "match": "choose two nights",
      "call": { "action": "browser_select", "echo": true, "params": { "pane": "browser-1", "ref": "e2", "option": "Two nights" } },
      "reply": "chose two nights"
    },
    {
      "match": "type the card number",
      "call": { "action": "browser_type", "echo": true, "params": { "pane": "browser-1", "ref": "e3", "text": "4242 4242 4242 4242" } },
      "reply": "typed the card number"
    },
    {
      "match": "confirm the booking",
      "call": { "action": "browser_click", "echo": true, "params": { "pane": "browser-1", "ref": "e5" } },
      "reply": "confirmed the booking"
    },
    {
      "match": "click confirm on the live form",
      "call": { "action": "browser_click", "echo": true, "params": { "pane": "browser-1", "ref": "e5" } },
      "reply": "clicked confirm on the live form"
    },
    {
      "match": "start the held agent in staging",
      "hold": "wakil-e2e-release-staging",
      "call": { "action": "api_open", "params": { "entry": "billing" } },
      "reply": "the held agent in staging finished"
    },
    {
      "match": "start the second agent in qa",
      "call": { "action": "api_open", "params": { "entry": "catalog" } },
      "reply": "the second agent answered in qa"
    },
    {
      "match": "hold a turn open here",
      "hold": "wakil-e2e-release-held",
      "reply": "a held turn was released"
    },
    {
      "match": "report my capacity at twelve percent",
      "emit": [
        {
          "type": "rate_limit_event",
          "rate_limit_info": {
            "status": "allowed",
            "unifiedWindows": {
              "five_hour": { "utilization": 0.88, "resetsAt": 4085208000 },
              "seven_day": { "utilization": 0.41, "resetsAt": 4085208000 }
            }
          }
        }
      ],
      "reply": "capacity reported for this turn"
    },
    {
      "match": "report my capacity at twenty-nine percent",
      "emit": [
        {
          "type": "rate_limit_event",
          "rate_limit_info": {
            "status": "allowed",
            "unifiedWindows": {
              "five_hour": { "utilization": 0.71, "resetsAt": 4085208000 },
              "seven_day": { "utilization": 0.18, "resetsAt": 4085208000 }
            }
          }
        }
      ],
      "reply": "capacity reported for this turn"
    },
    {
      "match": "propose a command that prints",
      "call": {
        "action": "term_propose",
        "params": { "pane": "terminal-1", "command": "echo proposed-by-the-agent" }
      },
      "reply": "I put `echo proposed-by-the-agent` in your prompt. Press return to accept it, and again to run it."
    },
    {
      "match": "what did my last command print",
      "read": { "pane": "terminal-1", "field": "blocks[-1].output[0]" },
      "reply": "your last command printed: {value}"
    },
    {
      "match": "say hello from the microphone",
      "reply": "the spoken turn arrived"
    },
    {
      "match": "thread turn one",
      "reply": "first reply in the thread"
    },
    {
      "match": "thread turn two",
      "reply": "second reply in the thread"
    },
    {
      "match": "thread turn three",
      "reply": "third reply in the thread"
    },
    {
      "match": "→ pane_move (action · wakil)",
      "reply": "the agent was handed pane_move"
    },
    {
      "match": "→ booking_id (column · pane ·",
      "reply": "the agent was handed booking_id from the open pane"
    },
    {
      "match": "→ booking_id (column · staging · bookings db)",
      "reply": "the agent was handed booking_id from the bookings schema"
    },
    {
      "match": "→ buildlaunch (code",
      "reply": "the agent was handed buildLaunch from the code"
    },
    {
      "match": "[wakil: identifiers in scope that match words in this turn",
      "reply": "a note arrived that no rule expected"
    },
    {
      "match": "tell me a short joke",
      "reply": "the joke turn arrived with no note"
    },
    {
      "match": "pane move pane focus pane close pane resize",
      "reply": "nine names arrived with no note"
    },
    {
      "match": "where does pane move live",
      "reply": "pane move arrived with no note"
    },
    {
      "match": "what is in booking id",
      "reply": "booking id arrived with no note"
    },
    {
      "match": "where is build launch defined",
      "reply": "build launch arrived with no note"
    },
    {
      "match": "say the instructions marker",
      "reply": "the instructions marker turn answered"
    },
    {
      "match": "write the workspace note",
      "call": { "action": "editor_create", "echo": true, "params": { "path": "{cwd}/../e2e-api/ws-note.txt", "kind": "file" } },
      "reply": "wrote the workspace note"
    },
    {
      "match": "start the copy from main",
      "call": { "action": "workspace_start", "echo": true, "params": { "repo": "e2e-api", "base": "main", "branch": "e2e-from-main-start" } },
      "reply": "started the copy from main"
    },
    {
      "match": "write the started note",
      "call": { "action": "editor_create", "echo": true, "params": { "path": "{cwd}/../e2e-api/started-note.txt", "kind": "file" } },
      "reply": "wrote the started note"
    },
    {
      "match": "where do you work",
      "reply": "map says: {map}"
    },
    {
      "match": "write the merged note",
      "call": { "action": "editor_create", "echo": true, "params": { "path": "{cwd}/../e2e-api/merged-note.txt", "kind": "file" } },
      "reply": "wrote the merged note"
    },
    {
      "match": "write the ticket note",
      "call": { "action": "editor_create", "echo": true, "params": { "path": "{cwd}/../e2e-api/ticket-note.txt", "kind": "file" } },
      "reply": "wrote the ticket note"
    }
  ]
}
