.superpowers/
.context/
bin/

# Binaries left at the repository root by a hand-run `go build ./cmd/X`
# without -o. `make build` always writes into bin/, but the by-hand form is
# what people reach for while debugging one server.
#
# Listed one by one, and anchored to the root with a leading slash, rather
# than as a `wakil-*` glob: a glob would also swallow a real source file
# someone later adds at the root (a wakil-something.go, a wakil-notes.md),
# and an unanchored pattern would hide files of the same name anywhere in
# the tree — including cmd/wakil/wakil if one were ever built in place.
/wakil
/wakil-ctx
/wakil-db
/wakil-git
/wakil-files
/wakil-http
/wakil-pm
/wakil-recall
/wakil-connect
app/.build/

# SwiftPM's build tree for the STT probe harness, which is a second Swift
# package in this repository (scripts/probe/sttspike). 475 MB of Core ML and
# WhisperKit artefacts, none of it source.
scripts/probe/sttspike/.build/
scripts/probe/sttspike/.swiftpm/

# The same, for the terminal-pane throughput harness (scripts/probe/termspike),
# the third Swift package here. Its .build carries a SwiftTerm checkout.
# Package.resolved is *not* ignored: the probe's numbers are against SwiftTerm
# 1.20.0 and a re-run that silently resolved a different version would not be
# a re-run.
scripts/probe/termspike/.build/
scripts/probe/termspike/.swiftpm/
app/Wakil.app/

# Generated by `make shaders` from app/Shaders/*.metal
app/Sources/WakilApp/default.metallib

# Finder metadata. Unanchored, because macOS writes one into any directory
# a Finder window has ever been opened on — five of them appeared in this
# tree during the 2b-iv acceptance walk alone, from `open`ing the capture
# directories. Ignored rather than committed: their contents change on
# every window move or icon rearrangement, so committing them would dirty
# the tree again immediately and permanently.
.DS_Store
e2e/bin/
