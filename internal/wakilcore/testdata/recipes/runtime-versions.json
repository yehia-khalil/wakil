        "name": "dev",
        "command": "npm run dev"
      }
    ],
    "ready": {
      "url": "http://localhost:$WAKIL_PORT/"
    },
    "notes": {
      "clone": "package.json",
      "ports.PORT": "most Node servers read PORT",
