{
  "repo": "runtime-versions",
  "kind": "node-npm",
  "recipe": {
    "ports": {
      "PORT": "$WAKIL_PORT"
    },
    "clone": [
      "node_modules"
    ],
    "setup": [
      "mise install",
      "npm install"
    ],
    "processes": [
