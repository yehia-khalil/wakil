{
  "repo": "laravel-sail",
  "kind": "laravel-sail",
  "recipe": {
    "ports": {
      "APP_PORT": "$WAKIL_PORT",
      "FORWARD_DB_PORT": "$WAKIL_PORT_2",
      "FORWARD_REDIS_PORT": "$WAKIL_PORT_3",
      "VITE_PORT": "$WAKIL_PORT_1"
    },
    "alsoWriteEnvFile": true,
    "copy": [
      ".env"
    ],
    "clone": [
      "vendor"
    ],
    "services": [
      "./vendor/bin/sail up -d mysql redis"
    ],
    "setup": [
      "composer install",
      "./vendor/bin/sail build"
    ],
    "processes": [
      {
        "name": "app",
        "command": "./vendor/bin/sail up laravel.test"
      },
      {
        "name": "queue",
        "command": "./vendor/bin/sail artisan queue:work",
        "afterReady": true
      }
    ],
    "ready": {
      "url": "http://localhost:$WAKIL_PORT/"
    },
    "teardown": [
      "./vendor/bin/sail down"
    ],
    "notes": {
      "alsoWriteEnvFile": "Sail's script reads .env itself, so the copy's .env is given the mapped ports; else its own lines win over Wakil's",
      "clone": "composer.json",
      "copy": "the ignored env files in your folder",
      "ports.APP_PORT": "docker-compose.yml publishes laravel.test's port from $APP_PORT, so nothing in it is rewritten",
      "ports.FORWARD_DB_PORT": "docker-compose.yml publishes mysql's port from $FORWARD_DB_PORT, so nothing in it is rewritten",
      "ports.FORWARD_REDIS_PORT": "docker-compose.yml publishes redis's port from $FORWARD_REDIS_PORT, so nothing in it is rewritten",
      "ports.VITE_PORT": "docker-compose.yml publishes laravel.test's port from $VITE_PORT, so nothing in it is rewritten",
      "processes.app": "docker-compose.yml (Sail) laravel.test",
      "processes.queue": ".env.example QUEUE_CONNECTION=rabbitmq; it starts once the app is ready, as it needs laravel.test up",
      "ready": "the app answering on $WAKIL_PORT",
      "services": "docker-compose.yml (Sail)",
      "setup": "composer.json; the images are built in setup, not under the ready timeout",
      "teardown": "docker-compose.yml (Sail)"
    }
  },
  "doesntRun": false,
  "runtimes": [],
  "missingEnv": [
    {
      "key": "DB_UMBRELLA_HOST",
      "example": "umbrella_mysql"
    },
    {
      "key": "QUEUE_CONNECTION",
      "example": "rabbitmq"
    }
  ],
  "hosts": [
    {
      "key": "DB_HOST",
      "host": "mysql",
      "file": ".env.example"
    },
    {
      "key": "DB_UMBRELLA_HOST",
      "host": "umbrella_mysql",
      "file": ".env.example"
    }
  ],
  "compose": {
    "file": "docker-compose.yml",
    "services": [
      "mysql",
      "redis"
    ],
    "appServices": [
      "laravel.test"
    ],
    "variables": [
      {
        "service": "laravel.test",
        "variable": "APP_PORT"
      },
      {
        "service": "laravel.test",
        "variable": "VITE_PORT"
      },
      {
        "service": "mysql",
        "variable": "FORWARD_DB_PORT"
      },
      {
        "service": "redis",
        "variable": "FORWARD_REDIS_PORT"
      }
    ],
    "fixedPorts": [],
    "containerNames": []
  },
  "questions": []
}
